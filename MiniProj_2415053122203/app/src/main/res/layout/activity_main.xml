<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:gravity="center_horizontal">

    <ImageView android:id="@+id/imgAvatar" android:layout_width="120dp" android:layout_height="120dp" android:src="@mipmap/ic_launcher"/>
    <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/tvDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" />
    <TextView android:id="@+id/tvGpaBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#D32F2F" android:textStyle="bold" android:layout_marginBottom="24dp"/>

    <Button android:id="@+id/btnEditProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chỉnh Sửa Hồ Sơ (Result API)" />
    <Button android:id="@+id/btnChangeAvatar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đổi Avatar (GetContent)" />
    <Button android:id="@+id/btnCallHotline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gọi Điện Thoại (Implicit)" />
    <Button android:id="@+id/btnRequestCamera" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xin Quyền Camera" />
</LinearLayout>